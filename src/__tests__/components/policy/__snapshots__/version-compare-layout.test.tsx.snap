exports[`VersionComparePanel：两侧都没有 layout 时 DOM 不变 > 两侧 layout.status = none：与改动前快照一致 1`] = `"<div class="bg-bg dark:bg-gray-800 rounded-lg shadow-lg"><div class="flex items-center justify-between px-6 py-4 border-b border-border dark:border-gray-700"><h2 class="text-xl font-semibold text-fg dark:text-white">policies.versionCompare.title</h2></div><div class="flex items-center gap-4 px-6 py-4 border-b border-border dark:border-gray-700"><div class="flex-1"><label class="block text-sm font-medium text-fg-muted dark:text-fg-subtle mb-1">policies.versionCompare.baseVersion</label><select class="w-full px-3 py-2 border border-border-strong dark:border-gray-600 rounded-md text-sm bg-bg dark:bg-gray-900 text-fg dark:text-white"><option value="2">v2 - PENDING_APPROVAL </option><option value="1">v1 - APPROVED policies.versionCompare.defaultSuffix</option></select></div><div class="text-fg-subtle self-end pb-2"><svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></div><div class="flex-1"><label class="block text-sm font-medium text-fg-muted dark:text-fg-subtle mb-1">policies.versionCompare.compareVersion</label><select class="w-full px-3 py-2 border border-border-strong dark:border-gray-600 rounded-md text-sm bg-bg dark:bg-gray-900 text-fg dark:text-white"><option value="2">v2 - PENDING_APPROVAL </option><option value="1">v1 - APPROVED policies.versionCompare.defaultSuffix</option></select></div></div><div class="flex items-center gap-4 px-6 py-2 text-sm border-b border-border dark:border-gray-700"><span class="text-success">policies.versionCompare.linesAdded:{"n":1}</span><span class="text-red-600 dark:text-red-400">policies.versionCompare.linesRemoved:{"n":1}</span></div><div class="p-4 overflow-x-auto"><div class="font-mono text-sm max-h-[500px] overflow-y-auto"><div class="flex "><span class="w-12 text-right px-2 text-fg-subtle dark:text-