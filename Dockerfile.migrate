# Migration runner image
# Built and tagged as wontlost/aster-cloud-migrate:<sha>
# Used by k3s Job to apply drizzle migrations against prod PG
#
# Why a separate image: aster-cloud itself runs on Cloudflare Workers (no PG
# client). Migrations need a Node+postgres environment that can reach the
# cluster-internal PG service.

FROM node:24-alpine

WORKDIR /app

# Minimal install: tsx + drizzle bits + postgres driver
# Pinning explicit versions keeps the migrate image stable while the main
# app upgrades. Update these when bumping dependencies in package.json.
RUN npm install --no-audit --no-fund \
      tsx@4.21.0 \
      drizzle-orm@0.45.1 \
      postgres@3.4.8 \
      drizzle-kit@0.31.9 \
      typescript@5.9.3

COPY drizzle.config.ts ./
COPY drizzle/ ./drizzle/
COPY src/db/schema.ts ./src/db/schema.ts
COPY scripts/migrate.ts ./scripts/migrate.ts

# 非 root 用户
USER node

CMD ["npx", "tsx", "scripts/migrate.ts"]
