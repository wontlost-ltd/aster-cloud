# ===========================================
# Aster Cloud Platform - Environment Variables
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Vercel Cron Jobs (Demo cleanup)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Database (Vercel Postgres / Supabase / Neon)
DATABASE_URL=postgresql://...

# K3S PostgreSQL via Cloudflare Hyperdrive (可选)
# 设置 USE_HYPERDRIVE=true 启用 k3s 数据库
USE_HYPERDRIVE=false
HYPERDRIVE_DATABASE_URL=postgresql://user:password@<hyperdrive-id>.hyperdrive.cloudflare.com:5432/database?sslmode=require

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...

# Resend (Email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@aster-lang.cloud

# Mixpanel (Analytics)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_TRIAL=true
NEXT_PUBLIC_TRIAL_DAYS=14

# ===========================================
# Aster Policy API (K3S Deployment)
# ===========================================
# Policy API 基础 URL (用于策略评估)
NEXT_PUBLIC_ASTER_POLICY_API_URL=https://policy.aster-lang.dev

# Policy API WebSocket URL (用于实时预览)
NEXT_PUBLIC_ASTER_POLICY_WS_URL=wss://policy.aster-lang.dev/ws/preview

# API 请求超时 (毫秒)
ASTER_POLICY_API_TIMEOUT=30000

# ===========================================
# Aster LSP WebSocket Server (standalone microservice — lsp-server.mjs)
# ===========================================
# Host the Monaco client connects to for language-server features.
NEXT_PUBLIC_LSP_HOST=lsp.aster-lang.dev

# Origin allowlist for the LSP WS upgrade (comma-separated). The upgrade gate
# FAILS CLOSED: a missing or unlisted Origin is rejected.
ALLOWED_ORIGINS=https://aster-lang.cloud,https://www.aster-lang.cloud,http://localhost:3000

# Max concurrent LSP sessions (DoS guard). Each session spawns a child process.
LSP_MAX_CONNECTIONS=50

# Shared-secret token for the LSP WS upgrade (server side). When set, upgrades
# must present a matching token via the `x-lsp-token` header OR `?token=` query.
# In production an UNSET token fails closed (all upgrades rejected). Generate with:
#   openssl rand -hex 32
LSP_AUTH_TOKEN=
# The same value, exposed to the browser client so Monaco can pass `?token=`.
# NOTE: a NEXT_PUBLIC_* token is visible to end users — it is a coarse
# anti-drive-by control on top of the (primary) Origin allowlist, not real auth.
NEXT_PUBLIC_LSP_TOKEN=
# Dev-only escape hatch: skip the token requirement when no token is provisioned.
# NEVER set this in production.
LSP_AUTH_DISABLED=false

# ── AI 工作台（ADR 0049，仅 SaaS）─────────────────────────────────
# 工作台基础地址；留空 = 功能关闭，沿用旧版 React 面板。需 https（localhost 除外）。
NEXT_PUBLIC_AI_WORKSPACE_URL=
# 灰度名单：`all` 或逗号分隔的用户 id（例：user_1,user_2）；留空 = 无人开启。
AI_WORKSPACE_ENABLED_FOR=
# 交接令牌签名私钥（Ed25519，base64 PKCS#8 DER）；对应公钥配置在工作台服务端。
AI_WORKSPACE_HANDOFF_PRIVATE_KEY=
# 工作台 → cloud 的 HMAC-SHA256 共享密钥（例：openssl rand -hex 32）。
AI_WORKSPACE_HMAC_KEY=
